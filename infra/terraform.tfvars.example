aws_region         = "eu-central-1"
project_name       = "ShiftPlanner"
environment        = "dev"
vpc_cidr           = "10.20.0.0/16"
public_subnet_cidr = "10.20.1.0/24"
instance_type      = "t3.small"

# SSH access requires both a trusted IPv4 CIDR and an existing EC2 key pair.
allowed_ssh_cidr = null
key_name         = null

github_repository = "wojtekp2002/ShiftPlanner"

# An existing provider ARN is required when the AWS account already has GitHub OIDC.
github_oidc_provider_arn = null
